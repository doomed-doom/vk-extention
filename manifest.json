{
  "manifest_version": 3,
  "name": "VK Photo Extension",
  "version": "1.0.0",
  "description": "Сохраняйте фотографии из чатов VK в папку или ZIP-архив, выбирайте снимки по дате и преобразуйте HEIC/HEIF в JPEG.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "VK Photo Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "storage",
    "offscreen",
    "scripting"
  ],
  "sandbox": {
    "pages": ["sandbox/heic-sandbox.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self'; worker-src blob:; object-src 'self';"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "host_permissions": [
    "https://vk.com/*",
    "https://*.vk.com/*",
    "https://vk.ru/*",
    "https://*.vk.ru/*",
    "https://*.vkuserphoto.ru/*",
    "https://*.userapi.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://vk.com/*",
        "https://*.vk.com/*",
        "https://vk.ru/*",
        "https://*.vk.ru/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
